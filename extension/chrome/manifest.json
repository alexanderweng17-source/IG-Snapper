{
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "2.3.3",
  "default_locale": "en",
  "author": {
    "name": "Gabriel de Rezende Gonçalves",
    "email": "contato@gabireze.com.br",
    "url": "https://gabireze.com.br/"
  },
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.instagram.com/*",
    "https://hihhomdldouekdymgmzn.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "__MSG_extensionTitle__"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "core.js",
        "instagram-api.js",
        "script.js"
      ],
      "matches": [
        "https://*.instagram.com/*"
      ]
    }
  ],
  "manifest_version": 3
}
