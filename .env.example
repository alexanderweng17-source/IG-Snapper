# Public values are safe to expose to the browser. Use Supabase project settings to obtain them.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Legacy alternative to the publishable key (public only; never use service_role here):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase credential. Never prefix with NEXT_PUBLIC_. Prefer the newer secret key if supported by your project.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Legacy server-side alternative:
# SUPABASE_SERVICE_ROLE_KEY=

# Server-only Stripe API secret. Start in Stripe test mode.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Canonical HTTPS URL for the deployed app; use http://localhost:3000 for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The store stays disabled until the owner explicitly enables it.
STORE_CHECKOUT_ENABLED=false
# Set these to real THB satang amounts (1 THB = 100 satang), after confirming the sale prices.
STORE_PRICE_30_DAYS_SATANG=
STORE_PRICE_90_DAYS_SATANG=
STORE_PRICE_365_DAYS_SATANG=

# Comma-separated allowlist of admin login emails. Leave empty to disable Admin access.
ADMIN_EMAILS=
